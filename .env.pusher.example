# ==========================================
# Upgrid Pusher Service - Production Env Example
# Copy this file to .env.pusher on EC2 and fill in actual credentials.
# NEVER commit real credentials to Git or Docker images.
# ==========================================

# AWS ElastiCache Serverless Valkey Queue Configuration
# Use REDIS_URL (takes priority over individual REDIS_HOST/PORT vars)
REDIS_URL="rediss://your-valkey-cluster-endpoint.serverless.aps1.cache.amazonaws.com:6379"

# Neon PostgreSQL Database Connection
DATABASE_URL="postgresql://username:password@ep-example-123456.us-east-1.aws.neon.tech/upgrid?sslmode=require"

# Probe Scheduling Interval in milliseconds (default: 120000 = 2 minutes)
PUSHER_INTERVAL_MS=120000
