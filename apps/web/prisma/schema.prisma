// This is the Prisma schema for apps/web (NextAuth OAuth tables)
// Mirrors packages/store/prisma/schema.prisma — keep in sync.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  username      String?   @unique
  password      String?
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  websites      Website[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Website {
  id           String         @id @default(cuid())
  url          String
  userId       String
  timeAdded    DateTime       @default(now())
  interval     Int            @default(180)
  lastProbedAt DateTime?
  ticks        website_tick[]
  user         User           @relation(fields: [userId], references: [id])
  regions      Region[]
}

model Region {
  id       String         @id @default(uuid())
  name     String         @unique
  ticks    website_tick[]
  websites Website[]
}

model website_tick {
  id               String        @id @default(uuid())
  response_time_ms Int
  status           WebsiteStatus
  region           Region        @relation(fields: [region_id], references: [id])
  website          Website       @relation(fields: [website_id], references: [id])
  region_id        String
  website_id       String
  createdAt        DateTime      @default(now())
}

enum WebsiteStatus {
  Up
  Down
  Unknown
}
