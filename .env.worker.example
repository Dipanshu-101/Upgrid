# ==========================================
# Upgrid Worker Service - Production Env Example
# Copy this file to .env.worker on EC2 and fill in actual credentials.
# NEVER commit real credentials to Git or Docker images.
# ==========================================

# Worker & Region Identification
REGION="india"
REGION_ID="11111111-1111-4111-8111-111111111111"
WORKER_ID="ec2-worker-1"

# AWS ElastiCache Serverless Valkey Queue Configuration
REDIS_HOST="your-valkey-cluster-endpoint.serverless.us-east-1.cache.amazonaws.com"
REDIS_PORT=6379
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_TLS="true"

# Neon PostgreSQL Database Connection
DATABASE_URL="postgresql://username:password@ep-example-123456.us-east-1.aws.neon.tech/upgrid?sslmode=require"
